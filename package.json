{
  "name": "harness-ai-desktop",
  "productName": "Harness AI",
  "version": "0.1.0",
  "private": true,
  "description": "Harness AI desktop workbench: Electron shell hosting the dsh runtime in-process",
  "type": "module",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "postinstall": "node scripts/install-electron.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "catalog:cordis",
    "@deepseek-ai/cordis-plugin-group": "catalog:cordis",
    "@deepseek-ai/cordis-plugin-include": "catalog:cordis",
    "@deepseek-ai/cordis-plugin-loader": "catalog:cordis",
    "@deepseek-ai/cordis-plugin-timer": "catalog:cordis",
    "@deepseek-ai/dsh-app-boot": "catalog:dsh"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "electron": "43.4.0",
    "electron-vite": "^4.0.0",
    "typescript": "6.0.3",
    "vite": "^7.0.0"
  }
}
